# ─────────────────────────────────────────────────────────────
# 本地 Docker 部署环境变量（WSL + Docker Desktop）
# 启动: docker compose --env-file .env.docker up -d --build
# ─────────────────────────────────────────────────────────────

# 运行模式 ---------------------------------------------------------
# MOCK_MODE=true 时所有 LLM/嵌入调用返回本地模拟数据，无需任何 API Key，
# 可先跑通全链路。改为 false 后需填入下方 LLM/EMBEDDING API Key。
MOCK_MODE=true

# 首次启动是否执行知识库导入 setup.py（true 会构建 ChromaDB 索引，需 EMBEDDING Key）
# MOCK_MODE=true 下建议保持 false，避免误连外部嵌入 API。
RUN_SETUP=false

# 数据库（compose 内部服务，backend 会用 MYSQL_HOST=mysql 覆盖）---------
MYSQL_DATABASE=agent_system
MYSQL_USER=agent
MYSQL_PASSWORD=agent_pass
MYSQL_ROOT_PASSWORD=root_pass

# JWT 密钥（生产环境务必改成随机长串）------------------------------
JWT_SECRET_KEY=change-me-in-production-please

# 浏览器可达的网关地址（统一同源，默认本机 8080）--------------------
PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_WS_URL=ws://localhost:8080

# Agent 工具调用开关（tool-calling）--------------------------------
# 默认关闭：Generation/Review 走纯 prompt 流程，行为与基线一致。
# 开启需 MOCK_MODE=false 且配置真实 LLM（MockLLM 不支持 tool-calling）。
USE_AGENT_TOOLS=false
AGENT_TOOL_MAX_ROUNDS=3

# LLM（OpenAI 兼容接口）MOCK_MODE=false 时必填 ----------------------
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 校验模型（可选，跨模型谬误核查；留空回落主 LLM）-------------------
VERIFIER_LLM_API_KEY=
VERIFIER_LLM_BASE_URL=
VERIFIER_LLM_MODEL=

# 嵌入模型（OpenAI 兼容接口）MOCK_MODE=false 且需知识库时必填 --------
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3

# 知识库 -----------------------------------------------------------
ENABLE_KNOWLEDGE_BASE=true
KNOWLEDGE_BASE_DIRS=../knowledge-base/cnc_domain
CHROMA_PERSIST_DIR=./chroma_db

# ============================================================
# 领域知识个性化生成与多智能体协同决策系统 - 环境变量配置
# ============================================================

# MySQL 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agent_system

# JWT 密钥（生产环境请更换为强密码）
JWT_SECRET_KEY=agent-system-secret-key-change-in-production

# Redis（多用户部署必须）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=          # 云服务器部署时必填
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# LLM 配置
LLM_PROVIDER=deepseek
LLM_API_KEY=             # 填入你的 DeepSeek API Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 嵌入模型 API（阿里云 DashScope）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=       # 填入你的 DashScope API Key
EMBEDDING_MODEL=text-embedding-v3

# ChromaDB 持久化目录
CHROMA_PERSIST_DIR=./chroma_db

# 知识库开关（True/False）
ENABLE_KNOWLEDGE_BASE=True

# 知识库目录（多个目录用逗号分隔，相对于 backend 目录）
KNOWLEDGE_BASE_DIRS=../knowledge-base/cnc_domain

# CORS 允许的源（多个用逗号分隔）
CORS_ORIGINS=["http://localhost:3000"]
